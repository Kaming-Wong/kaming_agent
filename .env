# Ollama (本地 LLM)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=bge-m3:latest
LLM_STRATEGY=ollama
EMBEDDING_STRATEGY=ollama

# Milvus (向量数据库)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_VECTOR_DIM=1024

# MySQL (对话持久化)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=kaming_agent

# MinIO (对象存储)
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaming-documents
MINIO_SECURE=false

# Redis (缓存)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=8018

# Neo4j (知识图谱)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kaming123456